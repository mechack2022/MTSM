			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/learners",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "learners"]
				},
				"description": "Test validation - should return 400 error"
			},
			"response": []
		},
		{
			"name": "Validation Test - Blank First Name",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"schoolId\": \"{{schoolId}}\",\n  \"firstName\": \"\",\n  \"lastName\": \"Doe\",\n  \"gradeLevelId\": \"{{gradeLevelId}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/learners",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "learners"]
				},
				"description": "Test validation - should return 400 error"
			},
			"response": []
		}
	]
}
