<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007-add-email-verification-to-app-user" author="system">
        <comment>Add email verification fields to app_user table for signup flow</comment>

        <!-- Add email column -->
        <addColumn tableName="app_user">
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="true" unique="true"/>
            </column>
        </addColumn>

        <!-- Add email_verified column -->
        <addColumn tableName="app_user">
            <column name="email_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Add email_verification_token column -->
        <addColumn tableName="app_user">
            <column name="email_verification_token" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Add email_verification_expiry column -->
        <addColumn tableName="app_user">
            <column name="email_verification_expiry" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Create index on email for faster lookups -->
        <createIndex indexName="idx_app_user_email" tableName="app_user">
            <column name="email"/>
        </createIndex>

        <!-- Create index on email_verification_token for faster lookups -->
        <createIndex indexName="idx_app_user_verification_token" tableName="app_user">
            <column name="email_verification_token"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
