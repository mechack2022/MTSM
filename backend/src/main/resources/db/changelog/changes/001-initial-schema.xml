<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ===================================================================== -->
    <!-- 001: Initial Schema - School Attendance System (Pilot)               -->
    <!-- Based on: BRD.md Section 8 - Data Requirements                       -->
    <!-- All IDs use UUID for offline-first compatibility                     -->
    <!-- ===================================================================== -->

    <!-- 1. School Table -->
    <changeSet id="001-create-school-table" author="system">
        <comment>Create school table - single school for pilot (BRD §8)</comment>
        <createTable tableName="school">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="address" type="varchar(500)"/>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 2. Learner Table -->
    <changeSet id="001-create-learner-table" author="system">
        <comment>Create learner table with deactivation support (BRD FR-3, BR-5)</comment>
        <createTable tableName="learner">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="school_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="student_number" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="grade_level" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_birth" type="date"/>
            <column name="sex" type="varchar(10)"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="learner"
                baseColumnNames="school_id"
                referencedTableName="school"
                referencedColumnNames="id"
                constraintName="fk_learner_school"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="learner"
                columnNames="school_id, student_number"
                constraintName="uk_learner_school_student_number"/>
    </changeSet>

    <!-- 3. Enrollment Table -->
    <changeSet id="001-create-enrollment-table" author="system">
        <comment>Create enrollment table - time-bound learner-to-class linking (BRD §8)</comment>
        <createTable tableName="enrollment">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="learner_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="academic_year" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="grade_level" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="class_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="enrollment_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="withdrawal_date" type="date"/>
            <column name="status" type="varchar(20)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="enrollment"
                baseColumnNames="learner_id"
                referencedTableName="learner"
                referencedColumnNames="id"
                constraintName="fk_enrollment_learner"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- 4. Attendance Table -->
    <changeSet id="001-create-attendance-table" author="system">
        <comment>Create attendance table - one record per learner/date (BRD BR-1, FR-10)</comment>
        <createTable tableName="attendance">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="learner_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="attendance_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="text"/>
            <column name="recorded_by" type="varchar(100)"/>
            <column name="recorded_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="change_id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="sync_status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="attendance"
                baseColumnNames="learner_id"
                referencedTableName="learner"
                referencedColumnNames="id"
                constraintName="fk_attendance_learner"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="attendance"
                columnNames="learner_id, attendance_date"
                constraintName="uk_attendance_learner_date"/>

        <createIndex tableName="attendance" indexName="idx_attendance_date">
            <column name="attendance_date"/>
        </createIndex>

        <createIndex tableName="attendance" indexName="idx_attendance_sync_status">
            <column name="sync_status"/>
        </createIndex>
    </changeSet>

    <!-- 5. Change Log Table -->
    <changeSet id="001-create-change-log-table" author="system">
        <comment>Create change_log table - audit trail for sync (BRD BR-2, FR-18)</comment>
        <createTable tableName="change_log">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="operation_type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="change_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="changed_data" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="previous_data" type="jsonb"/>
            <column name="changed_by" type="varchar(100)"/>
            <column name="sync_status" type="varchar(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="change_log" indexName="idx_change_log_entity">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>

        <createIndex tableName="change_log" indexName="idx_change_log_sync_status">
            <column name="sync_status"/>
        </createIndex>

        <createIndex tableName="change_log" indexName="idx_change_log_change_id">
            <column name="change_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
