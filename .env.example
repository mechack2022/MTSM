# ============================================================================
# MTSMS - MULTI-TENANT SCHOOL MANAGEMENT SYSTEM
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and update with your actual values:
#   cp .env.example .env
#
# DO NOT commit .env to version control
# ============================================================================

# ===========================================================================
# DATABASE CONFIGURATION
# ===========================================================================
POSTGRES_DB=mtsms
POSTGRES_USER=mtsms
POSTGRES_PASSWORD=your_secure_password_here

# Keycloak Database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=your_secure_password_here

# ===========================================================================
# KEYCLOAK CONFIGURATION
# ===========================================================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_admin_password_here

# Keycloak Realm
KEYCLOAK_REALM=MTSMS
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080

# Keycloak Backend Client (for Spring Boot service-to-service)
KEYCLOAK_CLIENT_ID=mtsms-backend
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# ===========================================================================
# PGADMIN CONFIGURATION
# ===========================================================================
PGADMIN_DEFAULT_EMAIL=admin@attendance.local
PGADMIN_DEFAULT_PASSWORD=your_admin_password_here

# ===========================================================================
# BACKEND APPLICATION CONFIGURATION
# ===========================================================================
SERVER_PORT=8090
SPRING_PROFILES_ACTIVE=dev

# ===========================================================================
# EMAIL CONFIGURATION (MailHog for development)
# ===========================================================================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@mtsms.local

# ===========================================================================
# FRONTEND CONFIGURATION (Vite - React)
# ===========================================================================
# Note: Vite only exposes variables prefixed with VITE_
VITE_API_BASE_URL=http://localhost:8090/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=MTSMS
VITE_KEYCLOAK_CLIENT_ID=mtsms-frontend
