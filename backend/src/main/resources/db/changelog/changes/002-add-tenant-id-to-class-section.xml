<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ===================================================================== -->
    <!-- 002: Add tenant_id to class_section for multi-tenancy support        -->
    <!-- ===================================================================== -->

    <changeSet id="002-01-add-tenant-id-to-class-section" author="system">
        <comment>Add tenant_id column to class_section table for multi-tenant support</comment>

        <!-- Step 1: Add the column as nullable first -->
        <addColumn tableName="class_section">
            <column name="tenant_id" type="uuid"/>
        </addColumn>

        <!-- Step 2: Populate tenant_id from school table -->
        <sql>
            UPDATE class_section cs
            SET tenant_id = s.tenant_id
            FROM school s
            WHERE cs.school_id = s.id;
        </sql>

        <!-- Step 3: Make tenant_id NOT NULL -->
        <addNotNullConstraint tableName="class_section" columnName="tenant_id"/>

        <!-- Step 4: Add foreign key constraint -->
        <addForeignKeyConstraint
            baseTableName="class_section"
            baseColumnNames="tenant_id"
            referencedTableName="tenant"
            referencedColumnNames="id"
            constraintName="fk_class_section_tenant"
            onDelete="CASCADE"/>

        <!-- Step 5: Add index for performance -->
        <createIndex tableName="class_section" indexName="idx_class_section_tenant">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-02-update-class-section-rls" author="system">
        <comment>Update RLS policy for class_section to include direct tenant_id check</comment>

        <!-- Drop the existing policy -->
        <sql>
            DROP POLICY IF EXISTS class_section_isolation ON class_section;
        </sql>

        <!-- Create updated policy with tenant_id check -->
        <sql>
            CREATE POLICY class_section_isolation ON class_section
            USING (
                current_setting('app.is_platform_admin', true) = 'true'
                OR tenant_id::text = current_setting('app.current_tenant_id', true)
                OR school_id IN (
                    SELECT school_id FROM app_user_school
                    WHERE app_user_id::text = current_setting('app.current_user_id', true)
                )
            );
        </sql>
    </changeSet>

</databaseChangeLog>
